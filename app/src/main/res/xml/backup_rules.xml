<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older full backup: exclude every domain (SPEC §6). Backup is also off in the manifest. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
